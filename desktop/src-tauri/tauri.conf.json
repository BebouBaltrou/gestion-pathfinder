{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestion Pathfinder",
  "version": "1.2.20",
  "identifier": "fr.gestion-pathfinder.bureau",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Gestion Pathfinder",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://api.github.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhFNDI1NUNDODBGNTg2NzUKUldSMWh2V0F6RlZDanZhdGhyUnFDdlRVUnZ4dXdrbG1wM2t2Q0d4WkNNVStOYWdWbFhYWEM4c2YK",
      "endpoints": [
        "https://raw.githubusercontent.com/BebouBaltrou/gestion-pathfinder/claude/v1.2/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
